# ── Bot credentials ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
CLIENT_ID=
CLAN_ID=
OWNER_ID=

# ── Google service account (shared across any Sheets-based feature) ───────────
# Full contents of a service account JSON key file, minified to one line.
# Share each target sheet with the service account's client_email as an
# Editor. See README.md → Setup → "Google service account" for instructions.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── Embed styling ──────────────────────────────────────────────────────────────
# Default accent color for embeds with no more specific meaning of their own
# Hex, with or without a # / 0x prefix.
DEFAULT_EMBED_COLOR=

# ── Roles ──────────────────────────────────────────────────────────────────────
OWNER_ROLE_ID=your_owner_role_id_here
COORDINATOR_ROLE_ID=your_coordinator_role_id_here
TEMPLAR_ROLE_ID=your_templar_role_id_here
# Anyone holding this role is fully ignored by /clanranks (sync and firstrun). Leave blank to
# disable (no one excluded).
GUEST_ROLE_ID=

# ── LFG forum posts (/lfg-post) ───────────────────────────────────────────────
# Forum Channel ID where /lfg-post posts get created as threads.
# Leave blank to disable /lfg-post.
LFG_FORUM_CHANNEL_ID= #// Set to Fourum top level id Provide this to Zach 
LFG_PLUGIN_TOKEN =  # // Do Not Change from the Value Zach Gave you
LFG_DELIVERY_SECRET =  # // Do Not Change from the Value Zach Gave you

# ── Donation high scores (/donationhighscore) ───────────────────────────────────
# The spreadsheet ID from the sheet's URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Make this a copy of Tanglebot/example/donationhighscores_template.xlsx — the bot
# expects a "Donations" tab by name (not configurable). Share it with the
# GOOGLE_SERVICE_ACCOUNT_JSON service account (set above) as an Editor.
DONATIONS_SHEET_ID=
# Channel where the leaderboard embed is posted
DONATIONS_CHANNEL_ID=
# GP thresholds per tier (raw numbers, e.g. 75000000 = 75M; defaults shown).
# Tiers stack — a Zenyte donor also keeps Onyx/Dragonstone/Diamond/Ruby.
# Leave a tier's role ID blank to skip role management for that tier.
DONATION_ZENYTE_THRESHOLD=1000000000
DONATION_ZENYTE_ROLE_ID=
DONATION_ONYX_THRESHOLD=600000000
DONATION_ONYX_ROLE_ID=
DONATION_DRAGONSTONE_THRESHOLD=300000000
DONATION_DRAGONSTONE_ROLE_ID=
DONATION_DIAMOND_THRESHOLD=150000000
DONATION_DIAMOND_ROLE_ID=
DONATION_RUBY_THRESHOLD=75000000
DONATION_RUBY_ROLE_ID=

# ── Pet high scores (/pethighscore) ────────────────────────────────────────────
# The spreadsheet ID from the sheet's URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Make this a copy of Tanglebot/example/pethighscores_template.xlsx — the bot
# expects its "Highscores" and "Pets" tabs by name (not configurable). Share
# it with the GOOGLE_SERVICE_ACCOUNT_JSON service account (set above) as an Editor.
PET_HIGHSCORES_SHEET_ID=
# Channel where the leaderboard embed is posted
PET_HIGHSCORES_CHANNEL_ID=
# Role granted once a member has this many pets or more (default 10);
# leave PET_MASTER_ROLE_ID blank to skip role management.
PET_MASTER_THRESHOLD=
PET_MASTER_ROLE_ID=

# ── Clan ranks (/clanranks) ──────────────────────────────────────────────────────
# The Wise Old Man group ID for the clan (from the group's URL: wiseoldman.net/groups/<THIS_PART>).
WOM_GROUP_ID=
# Optional — sent as x-api-key. Only needed if you hit WOM's rate limits.
WOM_API_KEY=
# The RSN-link spreadsheet ID (from the sheet's URL). Copy clanranks_template.xlsx — expects a
# "RankLinks" tab. Share with the GOOGLE_SERVICE_ACCOUNT_JSON service account as an Editor.
CLAN_RANKS_SHEET_ID=
# 5-field cron expression (UTC) for when the rank sync runs. Defaults to "0 0 * * 0" (Sunday
# 00:00 UTC) if unset/invalid.
CLAN_RANKS_CRON=0 0 * * 0
# Rank ladder (name, emoji, tenure, static flag) lives in Tanglebot/data/clan-ranks.json — see
# README.md → /clanranks for setup.

# ── Admin log channel ─────────────────────────────────────────────────────────
# Channel ID where admin/bot activity logs are sent for review.
# Leave blank to disable.
ADMIN_LOG_CHANNEL_ID=

# ── Announcement channel cleanup ──────────────────────────────────────────────
# Channel ID where crossposted "[Original Message Deleted]" messages are auto-removed.
# Leave blank to disable.
ANNOUNCEMENT_CHANNEL_ID=

# ── Honeypot channel trap ───────────────────────────────────────────────────────
# Channel ID(s) that act as a trap. Each is cleared and posted with a warning on
# startup; anyone who posts in one is timed out for 1 week and reported to
# ADMIN_LOG_CHANNEL_ID. Leave both blank to disable. Set either or both to enable —
# HONEYPOT_CHANNEL_ID for a text channel, HONEYPOT_VOICE_CHANNEL_ID for a voice
# channel's text chat. Admin buttons (ban & delete messages / false positive
# un-timeout) and /honeypot testmode require the OWNER_ROLE_ID or TEMPLAR_ROLE_ID role.
HONEYPOT_CHANNEL_ID=
HONEYPOT_VOICE_CHANNEL_ID=

# ── KC/drop proof submission intake ───────────────────────────────────────────
# Leave all four blank/unset to disable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DISCORD_KC_INTAKE_URL=
DISCORD_KC_INTAKE_SECRET=

# Local runtime overrides
# `/submission setintakeurl` stores a local override in `Tanglebot/data/submission-runtime-config.json`.
