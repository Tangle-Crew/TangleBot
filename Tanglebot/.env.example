# ── Bot credentials ────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
CLIENT_ID=
CLAN_ID=

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
# Required for /donationhighscore, /pethighscore and /refreshboards (and the other
# database features). The bot applies the files in migrations/ on startup.
# Example (Docker): postgres://tanglebot:<password>@tanglebot-db:5432/tanglebot
# See README.md → Setup → "Database".
DATABASE_URL=
# Days of command log to keep (default 365, 0 keeps everything). Needs DATABASE_URL.
COMMAND_LOG_RETENTION_DAYS=
# Minutes between automatic Wise Old Man syncs of the clan's accounts and history (default 60,
# 0 for manual only). Needs DATABASE_URL and WOM_GROUP_ID, and does nothing until the first
# /memberdata sync has been run by hand.
MEMBER_SYNC_INTERVAL_MINUTES=
# Seconds between database health checks (default 60, 0 turns the checks and their alerts off).
DB_HEALTH_CHECK_SECONDS=
# Failed checks in a row before the admin log is alerted (default 3).
DB_HEALTH_FAILURES_BEFORE_ALERT=
# Minutes between reminders while the database stays unreachable (default 60, 0 for none).
DB_HEALTH_REMINDER_MINUTES=

# ── Quiet members (/quietmembers and /activitybackfill) ───────────────────────
# /quietmembers needs DATABASE_URL, CLAN_ID, TEMPLAR_ROLE_ID and ADMIN_LOG_CHANNEL_ID.
# Set to true to load the one-time /activitybackfill command (Owner; also needs
# OWNER_ROLE_ID), then back to false and restart once the backfill has finished.
ACTIVITY_BACKFILL_ENABLED=false

# ── Embed styling ──────────────────────────────────────────────────────────────
# Default embed color, hex with or without a # / 0x prefix (default 006400).
DEFAULT_EMBED_COLOR=

# ── Roles ──────────────────────────────────────────────────────────────────────
OWNER_ROLE_ID=your_owner_role_id_here
COORDINATOR_ROLE_ID=your_coordinator_role_id_here
TEMPLAR_ROLE_ID=your_templar_role_id_here

# ── LFG forum posts (/lfg-post) ───────────────────────────────────────────────
# Forum Channel ID where /lfg-post creates its threads.
# Leave blank to disable /lfg-post.
LFG_FORUM_CHANNEL_ID=
# Optional channel for a line when each LFG group closes. Defaults to ADMIN_LOG_CHANNEL_ID.
LFG_LOG_CHANNEL_ID=

# ── Donation high scores (/donationhighscore) ───────────────────────────────────
# Channel where the leaderboard embed is posted
DONATIONS_CHANNEL_ID=
# GP thresholds per tier (raw numbers, e.g. 75000000 = 75M; defaults shown).
# Tiers stack — a Zenyte donor also keeps Onyx/Dragonstone/Diamond/Ruby.
# Leave a tier's role ID blank to skip role management for that tier.
DONATION_ZENYTE_THRESHOLD=1000000000
DONATION_ZENYTE_ROLE_ID=
DONATION_ONYX_THRESHOLD=600000000
DONATION_ONYX_ROLE_ID=
DONATION_DRAGONSTONE_THRESHOLD=300000000
DONATION_DRAGONSTONE_ROLE_ID=
DONATION_DIAMOND_THRESHOLD=150000000
DONATION_DIAMOND_ROLE_ID=
DONATION_RUBY_THRESHOLD=75000000
DONATION_RUBY_ROLE_ID=

# ── Pet high scores (/pethighscore) ────────────────────────────────────────────
# Channel where the leaderboard embed is posted
PET_HIGHSCORES_CHANNEL_ID=
# Role granted once a member has this many pets or more (default 10);
# leave PET_MASTER_ROLE_ID blank to skip role management.
PET_MASTER_THRESHOLD=
PET_MASTER_ROLE_ID=

# ── Wise Old Man ─────────────────────────────────────────────────────────────
# Your clan's WOM group ID and verification code (wiseoldman.net → your group →
# settings → Verification Code). With ADMIN_LOG_CHANNEL_ID set, also enables
# the competition ending reminder.
WOM_GROUP_VERIFICATION_CODE=
WOM_GROUP_ID=
# WOM API rate limits (docs.wiseoldman.net): 20 requests/minute without a key,
# 100/minute with one. Ask for a key on the Wise Old Man Discord (linked from
# wiseoldman.net); it's sent as the x-api-key header. What the bot uses:
#   /weeklycompstats   1 + 1 per running competition, at most once every 5 minutes
#                      (runs in between share it; sooner when a competition
#                      starts or ends, and 1 minute after an error)
#   /weeklycomp        1 per competition created
#   Ending reminder    1 every 15 minutes; when a competition is ending, also
#                      1 update all + 1 per ending competition
#   /weeklyannounce    about 8 per competition for each preview and each send,
#                      one at a time (3.5 seconds apart, 0.7 with a key)
#   /memberdata and the automatic sync: one call every 3.5 seconds (0.7 with a key)
# Every feature shares one limit in the bot: at most 18 calls start in any minute
# (90 with a key); a call over it waits until it fits.
# Optional API key for the higher limit:
WOM_API_KEY=

# ── Admin log channel ─────────────────────────────────────────────────────────
# Channel ID where admin/bot activity logs are sent for review.
# Leave blank to disable.
ADMIN_LOG_CHANNEL_ID=

# ── Weekly winners and announcements (/weeklyannounce) ────────────────────────
# Channel ID the weekly post goes to. When set, the command has no channel
# option; leave blank to pick the channel each time. The command also needs
# TEMPLAR_ROLE_ID, WOM_GROUP_ID and ADMIN_LOG_CHANNEL_ID.
WEEKLY_ANNOUNCE_CHANNEL_ID=

# ── Announcement channel cleanup ──────────────────────────────────────────────
# Channel ID where crossposted "[Original Message Deleted]" messages are auto-removed.
# Leave blank to disable.
ANNOUNCEMENT_CHANNEL_ID=

# ── Honeypot channel trap ───────────────────────────────────────────────────────
# Channel ID(s) that act as a trap. Each is cleared and posted with a warning on
# startup; anyone who posts in one is timed out for 1 week and reported to
# ADMIN_LOG_CHANNEL_ID. Leave both blank to disable. Set either or both to enable —
# HONEYPOT_CHANNEL_ID for a text channel, HONEYPOT_VOICE_CHANNEL_ID for a voice
# channel's text chat. Admin buttons (ban & delete messages / false positive
# un-timeout) and /honeypot testmode require the OWNER_ROLE_ID or TEMPLAR_ROLE_ID role.
HONEYPOT_CHANNEL_ID=
HONEYPOT_VOICE_CHANNEL_ID=

# Staff channel for the admin commands post (a list of the loaded staff commands). Leave blank to
# turn it off. Only the bot should be able to post there.
ADMIN_COMMANDS_CHANNEL_ID=

# ── Supabase-backed clan features ─────────────────────────────────────────────
# Supabase credentials are shared with proof intake. Roster commands require
# a separate opt-in after their migrations and website have been deployed.
CLAN_ROSTER_COMMANDS_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Website origin used by /link and /linkalt confirmation URLs.
# Optional; defaults to https://tanglecrew.group.
CLAN_WEBSITE_URL=https://tanglecrew.group

# KC/drop proof submission intake. Leave both values below blank to disable it.
SUPABASE_DISCORD_KC_INTAKE_URL=
DISCORD_KC_INTAKE_SECRET=

# Local runtime overrides
# `/submission setintakeurl` stores a local override in `Tanglebot/data/submission-runtime-config.json`.
